#!/usr/bin/env bash
# Add a YDB git worktree + Cursor/ya IDE setup for a branch.
# A new branch is created from a freshly pulled main; an existing branch
# (for example a colleague's PR branch fetched for review) is used as is.
#
# Usage (from the main ydb repo, not a worktree):
#   ydb-add-worktree [-p prefix] <feature_name> [folders_for_ya_ide...]
#
# Defaults for IDE folders:
#   ./ydb/core/tx ./ydb/core/kqp/ut/olap

set -euo pipefail

usage() {
  cat <<'EOF' >&2
Usage: ydb-add-worktree [-p prefix] <feature_name> [folders_for_ya_ide...]

Must be run from the main ydb repository (not a worktree).

The branch is created from main when it does not exist yet, and used as is otherwise.
The worktree goes to ../<feature_name>, or ../<prefix>-<feature_name> with -p.

Examples:
  ydb-add-worktree my-feature
  ydb-add-worktree -p pr colleague/their-fix
  ydb-add-worktree my-feature ./ydb/core/tx ./ydb/core/kqp/ut/olap
EOF
  exit 1
}

prefix=
while getopts ":p:h" opt; do
  case "$opt" in
    p) prefix=$OPTARG ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))

if [[ $# -lt 1 ]]; then
  usage
fi

feature_name=$1
shift

if [[ $# -gt 0 ]]; then
  folders=("$@")
else
  folders=(./ydb/core/tx ./ydb/core/kqp/ut/olap)
fi

slug=${feature_name//\//-}
worktree_name="${prefix:+${prefix}-}${slug}"
worktree_path="../${worktree_name}"
ide_project_dir="${HOME}/ide/${worktree_name}"
workspace_name="${worktree_name}"

clangd_src="${HOME}/dotfiles/ydb/.clangd"
if [[ ! -f "$clangd_src" ]]; then
  echo "error: missing shared clangd config: ${clangd_src}" >&2
  exit 1
fi

# Must be at the main repo root (`.git` is a directory; worktrees use a `.git` file).
if [[ ! -d .git ]]; then
  echo "error: run this from the main ydb repo root, not a worktree" >&2
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel)
if [[ "$PWD" != "$repo_root" ]]; then
  echo "error: run this from the repo root (${repo_root})" >&2
  exit 1
fi

if [[ -e "$worktree_path" ]]; then
  echo "error: worktree path already exists: ${worktree_path}" >&2
  exit 1
fi

current_branch=$(git branch --show-current)
if git show-ref --verify --quiet "refs/heads/${feature_name}"; then
  if [[ "$current_branch" == "$feature_name" ]]; then
    echo "→ ${feature_name} is checked out here; switching to main..."
    git switch main
  fi
  echo "→ creating worktree ${worktree_path} for existing branch ${feature_name}..."
  git worktree add "$worktree_path" "$feature_name"
else
  if [[ "$current_branch" == "main" ]]; then
    echo "→ on main; pulling from official..."
    git pull --ff-only official main
  else
    echo "→ fetching official main into local main..."
    git fetch official main:main
    echo "→ switching to main..."
    git switch main
  fi
  echo "→ creating worktree ${worktree_path} (new branch ${feature_name} from main)..."
  git worktree add -b "$feature_name" "$worktree_path"
fi

echo "→ initializing ya IDE project in ${worktree_path}..."
(
  cd "$worktree_path"
  ya ide vscode \
    --cursor \
    --cpp \
    -P "$ide_project_dir" \
    -W "$workspace_name" \
    --use-arcadia-root \
    "${folders[@]}"

  echo "→ linking compile_commands.json..."
  ln -s "${ide_project_dir}/compile_commands.json" compile_commands.json

  echo "→ linking .clangd..."
  ln -s "${clangd_src}" .clangd

  echo "→ linking .cursorignore..."
  ln -s ../.cursorignore .cursorignore

  # -f: replace an existing .cursorindexingignore (file or symlink)
  echo "→ linking .cursorindexingignore..."
  ln -s .cursorindexingignore-personal .cursorindexingignore
)

echo "done: ${worktree_path} (branch ${feature_name})"
echo "cd ${worktree_path}"
