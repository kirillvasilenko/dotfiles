#!/usr/bin/env bash
# gh-pr-comments — list every review thread you're part of in a PR, with a
# direct permalink to your own comment in each thread.
#
# Requires: gh (https://cli.github.com), authenticated with `gh auth login`.
# jq is NOT required — gh has a jq engine built in.
#
# Usage:
#   gh-pr-comments https://github.com/owner/repo/pull/1234
#   gh-pr-comments 1234                  # from inside the repo checkout
#
# By default: your threads, unresolved only.
#   -r  include resolved threads   -a  everyone's threads, not only yours
#   gh-pr-comments -r 1234               # yours, resolved and unresolved
#   gh-pr-comments -a 1234               # everyone's, unresolved
#   gh-pr-comments -ar 1234              # everyone's, everything
#   gh-pr-comments -u someone 1234       # someone else's comments
#   gh-pr-comments -m 1234 > notes.md    # markdown output
#   gh-pr-comments -i 1234               # pick one with fzf, opens in browser

set -euo pipefail

WHO=""
ONLY_MINE=1
FORMAT=text
INTERACTIVE=0
SHOW_RESOLVED=0

usage() {
  sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
}

while getopts ":u:amirh" opt; do
  case "$opt" in
    u) WHO="$OPTARG" ;;
    a) ONLY_MINE=0 ;;
    m) FORMAT=md ;;
    i) INTERACTIVE=1 ;;
    r) SHOW_RESOLVED=1 ;;
    h|*) usage ;;
  esac
done
shift $((OPTIND - 1))
[ $# -ge 1 ] || usage

ARG="$1"
if [[ "$ARG" =~ github\.com/([^/]+)/([^/]+)/pull/([0-9]+) ]]; then
  OWNER="${BASH_REMATCH[1]}"; REPO="${BASH_REMATCH[2]}"; PR="${BASH_REMATCH[3]}"
elif [[ "$ARG" =~ ^[0-9]+$ ]]; then
  PR="$ARG"
  NWO="$(gh repo view --json nameWithOwner -q .nameWithOwner)"
  OWNER="${NWO%%/*}"; REPO="${NWO##*/}"
else
  echo "error: give a PR URL or a PR number" >&2
  usage
fi

if [ -z "$WHO" ]; then
  WHO="$(gh api user -q .login)"
fi
[ "$ONLY_MINE" -eq 1 ] || WHO=""

read -r -d '' QUERY <<'GRAPHQL' || true
query($owner:String!, $repo:String!, $pr:Int!, $endCursor:String) {
  repository(owner:$owner, name:$repo) {
    pullRequest(number:$pr) {
      reviewThreads(first:100, after:$endCursor) {
        pageInfo { hasNextPage endCursor }
        nodes {
          isResolved
          isOutdated
          path
          line
          originalLine
          comments(first:100) {
            totalCount
            nodes {
              url
              body
              createdAt
              author { login }
            }
          }
        }
      }
    }
  }
}
GRAPHQL

# gh's built-in --jq takes no external variables, so inline the login.
if [ -n "$WHO" ]; then
  SELECT="select(any(.comments.nodes[]; .author.login == \"$WHO\"))"
  PICK_COMMENT="(\$t.comments.nodes | map(select(.author.login == \"$WHO\")))[0]"
else
  SELECT="."
  PICK_COMMENT="\$t.comments.nodes[0]"
fi

if [ "$SHOW_RESOLVED" -eq 1 ]; then
  OPEN_SELECT=""
  SCOPE_NOTE=""
else
  OPEN_SELECT="| select(.isResolved | not)"
  SCOPE_NOTE=" (unresolved only)"
fi

FILTER="
.data.repository.pullRequest.reviewThreads.nodes[]
| $SELECT
$OPEN_SELECT
| . as \$t
| $PICK_COMMENT as \$c
| [ (if \$t.isOutdated then \"OUTDATED\" else \"current\"  end),
    (if \$t.isResolved then \"resolved\" else \"OPEN\"     end),
    (\$t.comments.totalCount | tostring),
    (\$t.path + \":\" + ((\$t.line // \$t.originalLine // 0) | tostring)),
    (\$c.createdAt | .[0:10]),
    (\$c.body | gsub(\"[\\r\\t]\"; \" \") | split(\"\\n\") | map(select(length > 0))[0] // \"(empty)\" | .[0:100]),
    \$c.url ]
| @tsv"

RAW="$(gh api graphql --paginate \
        -f owner="$OWNER" -f repo="$REPO" -F pr="$PR" \
        -f query="$QUERY" --jq "$FILTER")"

if [ -z "$RAW" ]; then
  echo "No matching review threads found in $OWNER/$REPO#$PR$SCOPE_NOTE." >&2
  exit 0
fi

# Sort: unresolved first, then by file path.
SORTED="$(printf '%s\n' "$RAW" | LC_ALL=C sort -t$'\t' -k2,2 -k4,4)"

if [ "$INTERACTIVE" -eq 1 ]; then
  if ! command -v fzf >/dev/null; then
    echo "error: -i needs fzf (brew install fzf)" >&2
    exit 1
  fi
  PICK="$(printf '%s\n' "$SORTED" \
    | awk -F'\t' '{printf "%-8s %-8s %3s msg  %-45s %s\n", $1, $2, $3, $4, $6}' \
    | fzf --no-sort --reverse --prompt="thread > ")" || exit 0
  IDX="$(printf '%s\n' "$SORTED" \
    | awk -F'\t' '{printf "%-8s %-8s %3s msg  %-45s %s\n", $1, $2, $3, $4, $6}' \
    | grep -nxF "$PICK" | head -1 | cut -d: -f1)"
  URL="$(printf '%s\n' "$SORTED" | sed -n "${IDX}p" | cut -f7)"
  open "$URL" 2>/dev/null || xdg-open "$URL" 2>/dev/null || echo "$URL"
  exit 0
fi

if [ "$FORMAT" = md ]; then
  echo "# Review threads in $OWNER/$REPO#$PR${WHO:+ (author: $WHO)}"
  echo
  printf '%s\n' "$SORTED" | awk -F'\t' '{
    printf "- **%s** · %s · %s msg · `%s` · %s\n", $2, $1, $3, $4, $5
    printf "  > %s\n", $6
    printf "  <%s>\n\n", $7
  }'
else
  printf '%s\n' "$SORTED" | awk -F'\t' '{
    printf "\n%-8s  %-8s  %3s msg  %s  (%s)\n", $2, $1, $3, $4, $5
    printf "    > %s\n", $6
    printf "    %s\n", $7
  }'
  echo
  printf '%s\n' "$SORTED" | wc -l | awk '{printf "%s thread(s).\n", $1}'
fi
